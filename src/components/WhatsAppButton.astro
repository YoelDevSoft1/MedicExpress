---
import Icon from './Icon.astro';
import { getWhatsappUrl } from '../data/services';

type Props = {
  label?: string;
  serviceName?: string;
  variant?: 'primary' | 'secondary';
  class?: string;
};

const {
  label = 'Consultar por WhatsApp',
  serviceName,
  variant = 'primary',
  class: className = ''
} = Astro.props;
---

<a
  class:list={[variant === 'primary' ? 'btn-primary' : 'btn-secondary', 'focus-ring', className]}
  href={getWhatsappUrl(serviceName, Astro.url.pathname)}
  target="_blank"
  rel="noopener noreferrer"
>
  <Icon name="brand-whatsapp" size={20} stroke-width={1.75} aria-hidden="true" />
  <span>{label}</span>
</a>

