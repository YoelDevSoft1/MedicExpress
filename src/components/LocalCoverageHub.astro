---
import Icon from './Icon.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { categoryPaths, services, type Service } from '../data/services';

type Props = {
  service?: Service;
  currentCategory?: string;
};

const { service, currentCategory } = Astro.props;

const bogotaZones = [
  {
    zone: 'Zona Norte de Bogotá',
    localities: 'Usaquén y Suba',
    barrios: 'Cedritos, Chicó, Santa Bárbara, Colina Campestre, Niza, Mazurén, Prado Veraniego',
  },
  {
    zone: 'Zona Chapinero y Centro-Oriente',
    localities: 'Chapinero, Teusaquillo y Barrios Unidos',
    barrios: 'Rosales, Chapinero Alto, Chicó Norte, Galerías, Nicolás de Federmán, Ciudad Salitre Oriental',
  },
  {
    zone: 'Zona Occidente y Aeropuerto',
    localities: 'Fontibón y Engativá',
    barrios: 'Modelia, Hayuelos, Salitre Occidental, Ciudad Salitre, Normandía, Álamos, Villas de Granada',
  },
  {
    zone: 'Zona Centro-Occidente y Sur-Occidente',
    localities: 'Kennedy y Puente Aranda',
    barrios: 'Mandalay, Castilla, Tintal, Marsella, Ciudad Montes, Américas, Villa Alsacia',
  },
];

const sabanaMunicipalities = [
  'Chía',
  'Cajicá',
  'Cota',
  'La Calera',
  'Mosquera',
  'Funza',
  'Madrid',
  'Soacha',
];

const activeServiceHubs = services.filter(
  (item) =>
    item.category !== 'Cobertura nacional' &&
    item.category !== 'Laboratorio clínico' &&
    item.slug !== service?.slug
);

const serviceLabel = service ? service.shortTitle.toLowerCase() : 'servicios médicos y de enfermería a domicilio';
---

<section id="cobertura-bogota" class="section border-t border-slate-200 bg-slate-50/90" aria-labelledby="cobertura-bogota-heading">
  <div class="container">
    <div class="grid gap-10 lg:grid-cols-[0.88fr_1.12fr] lg:items-start">
      <div>
        <p class="kicker">Cobertura local en Bogotá D.C.</p>
        <h2 id="cobertura-bogota-heading" class="mt-3 text-3xl font-black tracking-tight text-slate-950 md:text-4xl">
          Zonas y localidades de atención para {serviceLabel} en Bogotá
        </h2>
        <p class="mt-4 text-base leading-7 text-slate-600">
          Coordinamos atención domiciliaria con el equipo operativo de <strong>SMD Vital Bogotá</strong> en las principales localidades y barrios de la ciudad. Al escribir por WhatsApp, indica tu barrio y horario requerido para validar el profesional disponible más cercano.
        </p>

        <div class="mt-6 rounded-3xl border border-indigo-100 bg-white p-5 shadow-sm">
          <div class="flex items-start gap-3">
            <Icon name="shield-check" class="mt-0.5 shrink-0 text-indigo-700" size={22} stroke-width={1.75} aria-hidden="true" />
            <div>
              <h3 class="text-base font-black text-slate-950">
                Municipios de la Sabana de Bogotá (sujetos a validación de cobertura)
              </h3>
              <p class="mt-1.5 text-sm leading-6 text-slate-600">
                Para solicitudes en <strong>{sabanaMunicipalities.join(', ')}</strong>, la viabilidad presencial, el horario y el recargo o tarifa de desplazamiento se confirman previamente por WhatsApp según disponibilidad operativa del día.
              </p>
            </div>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-3">
          <WhatsAppButton
            label={service ? `Confirmar cobertura para ${service.shortTitle}` : 'Confirmar cobertura en mi barrio'}
            serviceName={service?.title ?? currentCategory}
          />
          <a class="focus-ring text-sm font-bold text-indigo-700 underline hover:text-indigo-900" href="/guias/coordinar-cuidado-domiciliario/">
            Guía familiar para coordinar atención en casa
          </a>
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {bogotaZones.map((item) => (
          <article class="rounded-[24px] border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-center gap-2 text-xs font-extrabold uppercase tracking-wider text-indigo-700">
              <Icon name="circle-check" size={16} stroke-width={2} aria-hidden="true" />
              <span>{item.zone}</span>
            </div>
            <h3 class="mt-2 text-lg font-black text-slate-950">{item.localities}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              <strong class="font-semibold text-slate-800">Sectores frecuentes:</strong> {item.barrios}.
            </p>
          </article>
        ))}
      </div>
    </div>

    <div class="mt-12 rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
      <div class="flex flex-col justify-between gap-4 border-b border-slate-100 pb-5 md:flex-row md:items-end">
        <div>
          <p class="kicker">Arquitectura de servicios · Hub &amp; Spoke</p>
          <h3 class="mt-2 text-2xl font-black text-slate-950">
            Directorio rápido de procedimientos y consultas en Bogotá
          </h3>
        </div>
        <div class="flex flex-wrap gap-2 text-xs font-extrabold">
          <a class="rounded-full bg-indigo-50 px-3.5 py-1.5 text-indigo-800 hover:bg-indigo-100" href={categoryPaths['Servicios médicos']}>
            Hub Servicios Médicos
          </a>
          <a class="rounded-full bg-indigo-50 px-3.5 py-1.5 text-indigo-800 hover:bg-indigo-100" href={categoryPaths['Enfermería']}>
            Hub Enfermería Domiciliaria
          </a>
          <a class="rounded-full bg-slate-100 px-3.5 py-1.5 text-slate-700 hover:bg-slate-200" href={categoryPaths['Cobertura nacional']}>
            Orientación Colombia
          </a>
        </div>
      </div>

      <ul class="mt-6 grid gap-3 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
        {activeServiceHubs.map((hubItem) => (
          <li>
            <a
              href={`/${hubItem.slug}/`}
              class="group flex h-full flex-col justify-between rounded-2xl border border-slate-200/80 bg-slate-50/60 p-3.5 transition hover:border-indigo-200 hover:bg-indigo-50/40"
            >
              <div>
                <span class="text-[11px] font-bold uppercase tracking-wide text-slate-500">{hubItem.category}</span>
                <p class="mt-0.5 text-sm font-extrabold text-slate-900 group-hover:text-indigo-700">
                  {hubItem.title}
                </p>
              </div>
              {hubItem.price && (
                <span class="mt-2 inline-block text-xs font-bold text-indigo-800">
                  {hubItem.price}
                </span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
