---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ServicePhoto from '../components/ServicePhoto.astro';
import ConversionPanel from '../components/ConversionPanel.astro';
import FAQSection from '../components/FAQSection.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TrustStrip from '../components/TrustStrip.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { categories, categoryPaths, getServicesByCategory, siteConfig, absoluteUrl } from '../data/services';

const title = 'MedicExpress | Servicios médicos a domicilio conectados con SMD Vital';
const description =
  'Consulta médica, auxiliares de enfermería y procedimientos a domicilio en Bogotá. Consulta precios y disponibilidad por WhatsApp. Atención coordinada por SMD Vital.';
const nationalPages = getServicesByCategory('Cobertura nacional');

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalBusiness',
  name: siteConfig.name,
  url: siteConfig.url,
  image: absoluteUrl('/img/medicexpress-og.jpg'),
  logo: absoluteUrl(siteConfig.logoPath),
  telephone: siteConfig.phone,
  areaServed: {
    '@type': 'City',
    name: 'Bogotá'
  },
  sameAs: [siteConfig.mainBrandUrl]
};

const faqs = [
  {
    question: 'MedicExpress y SMD Vital son lo mismo?',
    answer:
      'Puedes solicitar atención desde MedicExpress. El equipo de SMD Vital Bogotá confirma el servicio, la zona, el horario y el precio antes de agendar.'
  },
  {
    question: 'Puedo solicitar el servicio directamente por WhatsApp?',
    answer:
      'Sí. El canal de WhatsApp permite validar servicio, ubicación, horario, datos básicos del paciente y disponibilidad.'
  },
  {
    question: 'Atienden urgencias vitales?',
    answer:
      'No reemplazamos una ruta de urgencias. Ante dificultad respiratoria severa, dolor torácico intenso, pérdida de conciencia o sangrado abundante, se debe acudir a urgencias.'
  }
];
---

<BaseLayout title={title} description={description} jsonLd={homeSchema}>
  <section class="container grid gap-8 py-10 sm:gap-12 md:py-16 lg:grid-cols-[1fr_0.92fr] lg:items-center lg:py-20">
    <div>
      <h1 class="text-balance max-w-3xl text-5xl font-black tracking-tight text-slate-950 md:text-7xl">
        Servicios médicos a domicilio en Bogotá
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">
        Solicita consulta médica, apoyo de auxiliares de enfermería o un procedimiento en casa.
        Cuéntanos qué necesitas y en qué localidad estás para confirmar precio y disponibilidad con SMD Vital.
      </p>
      <p class="mt-4 inline-flex max-w-2xl rounded-full bg-indigo-50 px-4 py-2 text-sm font-black text-indigo-800 ring-1 ring-indigo-100">
        {siteConfig.referralMessage}
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <WhatsAppButton label="Agendar por WhatsApp" />
        <a class="btn-secondary" href="#servicios">
          <span>Explorar servicios</span>
          <Icon name="arrow-right" size={20} stroke-width={1.75} aria-hidden="true" />
        </a>
      </div>
      <div class="mt-8 grid max-w-2xl gap-3 sm:grid-cols-3">
        {['Orientación inicial', 'Servicios en casa', 'Conexión SMD Vital'].map((item) => (
          <div class="flex items-center gap-2 text-sm font-bold text-slate-700">
            <Icon name="circle-check" class="text-indigo-700" size={20} stroke-width={1.75} aria-hidden="true" />
            <span>{item}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="surface relative overflow-hidden rounded-[36px] p-6">
      <div class="absolute right-0 top-0 h-32 w-32 rounded-bl-[60px] bg-indigo-100"></div>
      <div class="relative"><ServicePhoto name="visita-medica" priority /></div>
      <div class="relative mt-5 grid gap-3 md:grid-cols-3">
        {[
          { icon: 'brand-whatsapp', label: 'WhatsApp', text: 'Datos básicos' },
          { icon: 'clipboard-check', label: 'Clasificación', text: 'Servicio y zona' },
          { icon: 'shield-plus', label: 'Atención', text: 'Paso responsable' }
        ].map(({ icon, label, text }) => (
          <div class="rounded-3xl bg-white p-4 shadow-lg shadow-slate-950/5">
            <Icon name={icon} class="text-indigo-700" size={20} stroke-width={1.75} aria-hidden="true" />
            <h2 class="mt-3 text-sm font-black text-slate-950">{label}</h2>
            <p class="mt-1 text-xs font-semibold text-slate-500">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <TrustStrip />

  <section id="colombia" class="section bg-white">
    <div class="container grid gap-10 lg:grid-cols-[0.78fr_1fr] lg:items-start">
      <div>
        <p class="kicker">Ubicación y disponibilidad</p>
        <h2 class="mt-3 text-4xl font-black tracking-tight text-slate-950 md:text-5xl">
          Confirma la atención según tu ciudad
        </h2>
        <p class="mt-5 text-lg leading-8 text-slate-600">
          La atención domiciliaria se coordina en Bogotá. Indica tu localidad, el servicio que necesitas y el horario deseado para revisar disponibilidad.
        </p>
        <p class="mt-4 rounded-3xl bg-indigo-50 p-5 text-sm font-bold leading-7 text-indigo-900 ring-1 ring-indigo-100">
          Si estás en otra ciudad, consulta si tu necesidad puede atenderse por teleconsulta. La atención presencial fuera de Bogotá no está confirmada.
        </p>
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        {nationalPages.map((service) => (
          <ServiceCard service={service} />
        ))}
      </div>
    </div>
  </section>

  <section id="servicios" class="section">
    <div class="container">
      <div class="max-w-3xl">
        <p class="kicker">Servicios y condiciones</p>
        <h2 class="mt-3 text-4xl font-black tracking-tight text-slate-950 md:text-5xl">
          Encuentra información sobre el servicio que necesitas
        </h2>
        <p class="mt-5 text-lg leading-8 text-slate-600">
          Revisa el alcance de cada servicio y consulta su disponibilidad antes de reservar.
          El equipo confirma el precio y las condiciones para tu caso.
        </p>
      </div>

      <div class="mt-12 space-y-12">
        {
          categories.filter((category) => category !== 'Cobertura nacional').map((category) => (
            <section>
              <div class="mb-5 flex items-end justify-between gap-4">
                <h3 class="text-2xl font-black text-slate-950">
                  <a class="focus-ring rounded-lg hover:text-indigo-700" href={categoryPaths[category]}>
                    {category}
                  </a>
                </h3>
                <span class="text-sm font-bold text-slate-500">{getServicesByCategory(category).length} páginas</span>
              </div>
              <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
                {getServicesByCategory(category).map((service) => (
                  <ServiceCard service={service} />
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <section id="proceso" class="section bg-white">
    <div class="container grid gap-12 lg:grid-cols-[0.82fr_1fr] lg:items-start">
      <div>
        <p class="kicker">Cómo solicitar atención</p>
        <h2 class="mt-3 text-4xl font-black tracking-tight text-slate-950 md:text-5xl">
          Coordina tu visita por WhatsApp
        </h2>
        <p class="mt-5 text-lg leading-8 text-slate-600">
          Puedes escribirnos como paciente o como familiar encargado de coordinar la visita.
          Revisamos los datos de tu solicitud antes de confirmar la atención.
        </p>
        <div class="mt-6"><ServicePhoto name="coordinacion-familiar" /></div>
      </div>
      <ol class="grid gap-4">
        {[
          'Elige el servicio y revisa su alcance y precio de referencia.',
          'Escríbenos por WhatsApp e indica localidad y horario deseado.',
          'El equipo revisa disponibilidad, requisitos y precio para tu caso.',
          'Confirma los detalles de la atención con SMD Vital antes de la visita.'
        ].map((step, index) => (
          <li class="surface flex gap-5 rounded-[28px] p-6">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-indigo-700 text-sm font-black text-white">
              {index + 1}
            </span>
            <p class="pt-2 text-base font-bold leading-7 text-slate-800">{step}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <ConversionPanel />
  <FAQSection faqs={faqs} />
</BaseLayout>
