---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ConversionPanel from '../components/ConversionPanel.astro';
import FAQSection from '../components/FAQSection.astro';
import NursingPrices from '../components/NursingPrices.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ServicePhoto from '../components/ServicePhoto.astro';
import type { ComponentProps } from 'astro/types';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { absoluteUrl, categoryPaths, getRelatedServices, requiresAvailabilityReview, services, siteConfig, type Service } from '../data/services';

type Props = {
  service: Service;
};

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service }
  }));
}

const { service } = Astro.props;
const review = requiresAvailabilityReview(service);
const description = review ? `${service.shortTitle}: consulta tu solicitud por WhatsApp. Confirmamos posibilidad de atención, zona, fecha, requisitos y cotización antes de reservar.` : service.metaDescription;
const relatedServices = getRelatedServices(service);
const isNationalPage = service.category === 'Cobertura nacional';
const isNursingPage = service.slug === 'servicios-de-enfermeria/enfermeria-a-nivel-domiciliario-y-hospitalario';
const servicePhotos: Record<string, ComponentProps<typeof ServicePhoto>['name']> = {
  'colombia': 'coordinacion-familiar',
  'medico-a-domicilio-colombia': 'material-visita-medica',
  'enfermeria-a-domicilio-colombia': 'auxiliar-cuidado',
  'teleconsulta-medica-colombia': 'teleconsulta-hogar',
  'servicios-medicos/servicio-medico-a-domicilio': 'visita-medica',
  'servicios-medicos/valoracion-medica-a-domicilio': 'visita-medica',
  'servicios-medicos/teleconsulta-medica': 'teleconsulta-hogar',
  'servicios-medicos/cura-de-heridas-simples-y-complejas': 'preparacion-curaciones',
  'servicios-medicos/sutura-y-retiro-de-puntos': 'preparacion-curaciones',
  'servicios-medicos/lavado-de-oido': 'valoracion-oidos',
  'servicios-de-enfermeria/enfermeria-a-nivel-domiciliario-y-hospitalario': 'auxiliar-cuidado',
  'servicios-de-enfermeria/toma-de-signos-vitales': 'signos-vitales',
  'servicios-de-enfermeria/acompanamiento-a-citas-medicas': 'acompanamiento-citas',
};
const servicePhoto = servicePhotos[service.slug];
const isRemoteConsultation = service.slug === 'teleconsulta-medica-colombia';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': isNationalPage ? 'MedicalWebPage' : 'MedicalProcedure',
  name: service.title,
  description: service.metaDescription,
  url: absoluteUrl(`/${service.slug}/`),
  provider: {
    '@type': 'MedicalBusiness',
    name: siteConfig.name,
    url: siteConfig.url,
    logo: absoluteUrl(siteConfig.logoPath),
    telephone: siteConfig.phone
  },
  areaServed: {
    '@type': isRemoteConsultation ? 'Country' : 'City',
    name: isRemoteConsultation ? 'Colombia' : 'Bogotá'
  }
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: service.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer
    }
  }))
};
---

<BaseLayout
  title={service.metaTitle}
  description={description}
  canonicalPath={`/${service.slug}/`}
  jsonLd={review ? { '@context': 'https://schema.org', '@type': 'WebPage', name: service.title, description, url: absoluteUrl(`/${service.slug}/`) } : [serviceSchema, faqSchema]}
>
  <section class="container py-10 md:py-16">
    <Breadcrumbs items={[
      { name: 'Inicio', path: '/' },
      ...(service.slug === 'colombia' ? [] : [{ name: service.category === 'Cobertura nacional' ? 'Colombia' : service.category, path: categoryPaths[service.category] }]),
      { name: service.shortTitle, path: `/${service.slug}/` },
    ]} />

    <div class="service-hero">
      <div class="service-intro">
        <p class="kicker">{service.category}</p>
        <h1 class="page-heading text-balance mt-3 font-extrabold tracking-tight text-slate-950">
          {service.h1}
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">{review ? description : service.summary}</p>
        <p class="coordination-note">
          {siteConfig.referralMessage}
        </p>
        <div class="service-offer">
          <div>
            <p class="text-xs font-semibold text-slate-500">Servicio solicitado</p>
            <h2 class="mt-1 text-lg font-bold text-slate-950">{service.shortTitle}</h2>
            <p class="mt-2 text-sm leading-6 text-slate-600">{review ? 'El equipo revisa el caso y la posibilidad de coordinar la atención antes de confirmar.' : service.intent}</p>
          </div>
          <div class="service-price">
            <span class="text-xs font-semibold text-slate-500">Referencia comercial</span>
            <p class="mt-1 text-xl font-extrabold text-indigo-950">{review ? 'Consultar disponibilidad' : service.price ?? 'Consultar disponibilidad'}</p>
          </div>
        </div>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <WhatsAppButton label="Consultar con SMD Vital" serviceName={service.title} /><a class="btn-secondary" href={isNursingPage ? '#precios-enfermeria' : '#detalles'}>{isNursingPage ? 'Ver precios y turnos' : 'Ver detalles'}</a>
        </div>
      </div>

      <aside class="service-visual" aria-label={`Información de ${service.shortTitle}`}>
        {servicePhoto && <ServicePhoto name={servicePhoto} priority />}
        <ul class="service-highlights">
          {(review ? ['Revisión de tu solicitud', 'Zona y fecha por confirmar', 'Cotización antes de reservar'] : service.highlights).map((highlight) => (
            <li class="flex items-start gap-3">
              <Icon name="circle-check" class="mt-0.5 shrink-0 text-indigo-700" size={20} stroke-width={1.75} aria-hidden="true" />
              <span class="text-sm font-medium leading-6 text-slate-700">{highlight}</span>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  {isNursingPage && <NursingPrices />}

  {
    isNationalPage && (
      <section class="section bg-slate-50">
        <div class="container grid gap-8 lg:grid-cols-[0.8fr_1fr] lg:items-start">
          <div>
            <p class="kicker">Zona de atención</p>
            <h2 class="mt-3 text-3xl font-black tracking-tight text-slate-950 md:text-4xl">
              Atención domiciliaria en Bogotá, según disponibilidad
            </h2>
            <p class="mt-5 text-base leading-8 text-slate-600">
              Indica la localidad o barrio, el servicio y el horario que necesitas. El equipo de SMD Vital Bogotá confirma si puede atender el caso y cuál es el precio antes de reservar.
            </p>
          </div>
          <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
            <h3 class="text-lg font-black text-slate-950">Si estás fuera de Bogotá</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              No tenemos cobertura domiciliaria confirmada en otras ciudades. Puedes consultar si una teleconsulta es adecuada para tu necesidad; el equipo debe confirmar disponibilidad y alcance. Una consulta virtual no sustituye los procedimientos presenciales.
            </p>
          </div>
        </div>
      </section>
    )
  }

  <section id="detalles" class="section bg-white">
    <div class="container grid gap-10 lg:grid-cols-3">
      <div class="rounded-[28px] border border-slate-200 p-6">
        <Icon name="shield-check" class="text-indigo-700" size={24} stroke-width={1.75} aria-hidden="true" />
        <h2 class="mt-5 text-2xl font-black text-slate-950">Cuándo puede servir</h2>
        <ul class="mt-5 space-y-3 text-sm leading-6 text-slate-600">
          {service.suitableFor.map((item) => (
            <li class="flex gap-3">
              <Icon name="circle-check" class="mt-0.5 shrink-0 text-indigo-700" size={20} stroke-width={1.75} aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-[28px] border border-slate-200 p-6 lg:col-span-2">
        <Icon name="clock" class="text-indigo-700" size={24} stroke-width={1.75} aria-hidden="true" />
        <h2 class="mt-5 text-2xl font-black text-slate-950">Cómo funciona</h2>
        <ol class="mt-5 grid gap-4 md:grid-cols-2">
          {service.process.map((step, index) => (
            <li class="rounded-2xl bg-slate-50 p-5">
              <span class="text-xs font-black text-indigo-700">Paso {index + 1}</span>
              <p class="mt-2 text-sm font-semibold leading-6 text-slate-700">{step}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  {
    relatedServices.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="max-w-2xl">
            <p class="kicker">Servicios relacionados</p>
            <h2 class="mt-3 text-3xl font-black tracking-tight text-slate-950 md:text-4xl">
              Otras páginas que pueden ayudar al paciente
            </h2>
          </div>
          <div class="mt-8 grid gap-5 md:grid-cols-3">
            {relatedServices.map((related) => (
              <ServiceCard service={related} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <FAQSection faqs={service.faqs} />
  <ConversionPanel service={service} title={`Consulta ${service.shortTitle.toLowerCase()} por WhatsApp`} />
</BaseLayout>

<style>
  .service-hero{display:grid;gap:32px;margin-top:32px;align-items:start}
  .service-offer{display:grid;gap:20px;margin-top:24px;padding:20px;border:1px solid #e2e8f0;border-radius:20px;background:#fff}
  .service-price{border-top:1px solid #e2e8f0;padding-top:16px}
  .service-visual{display:grid;gap:20px}
  .service-highlights{padding:8px 20px;border:1px solid #e2e8f0;border-radius:20px;background:#fff}
  .service-highlights li{padding-block:14px}
  .service-highlights li+li{border-top:1px solid #f1f5f9}
  @media(min-width:640px){.service-offer{grid-template-columns:minmax(0,1fr) minmax(140px,0.65fr);align-items:center}.service-price{border-top:0;border-left:1px solid #e2e8f0;padding-top:0;padding-left:20px}}
  @media(min-width:1024px){.service-hero{grid-template-columns:minmax(0,1.08fr) minmax(0,0.92fr);gap:48px}}
</style>

