---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ConversionPanel from '../components/ConversionPanel.astro';
import FAQSection from '../components/FAQSection.astro';
import LocalCoverageHub from '../components/LocalCoverageHub.astro';
import NursingPrices from '../components/NursingPrices.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ServicePhoto from '../components/ServicePhoto.astro';
import type { ComponentProps } from 'astro/types';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { absoluteUrl, categoryPaths, getRelatedServices, requiresAvailabilityReview, services, siteConfig, type Service } from '../data/services';

type Props = {
  service: Service;
};

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service }
  }));
}

const { service } = Astro.props;
const review = requiresAvailabilityReview(service);
const description = review ? `${service.shortTitle}: consulta tu solicitud por WhatsApp. Confirmamos posibilidad de atención, zona, fecha, requisitos y cotización antes de reservar.` : service.metaDescription;
const relatedServices = getRelatedServices(service);
const isNationalPage = service.category === 'Cobertura nacional';
const isNursingPage = service.slug === 'servicios-de-enfermeria/enfermeria-a-nivel-domiciliario-y-hospitalario';
const isSuturaPage = service.slug === 'servicios-medicos/sutura-y-retiro-de-puntos';
const isSondaPage = service.slug === 'servicios-medicos/retiro-y-colocacion-de-sonda-vesical';
const isValoracionPage = service.slug === 'servicios-medicos/valoracion-medica-a-domicilio' || service.slug === 'servicios-medicos/servicio-medico-a-domicilio';
const servicePhotos: Record<string, ComponentProps<typeof ServicePhoto>['name']> = {
  'colombia': 'coordinacion-familiar',
  'medico-a-domicilio-colombia': 'material-visita-medica',
  'enfermeria-a-domicilio-colombia': 'auxiliar-cuidado',
  'teleconsulta-medica-colombia': 'teleconsulta-hogar',
  'servicios-medicos/servicio-medico-a-domicilio': 'visita-medica',
  'servicios-medicos/valoracion-medica-a-domicilio': 'visita-medica',
  'servicios-medicos/teleconsulta-medica': 'teleconsulta-hogar',
  'servicios-medicos/cura-de-heridas-simples-y-complejas': 'preparacion-curaciones',
  'servicios-medicos/sutura-y-retiro-de-puntos': 'preparacion-curaciones',
  'servicios-medicos/lavado-de-oido': 'valoracion-oidos',
  'servicios-de-enfermeria/enfermeria-a-nivel-domiciliario-y-hospitalario': 'auxiliar-cuidado',
  'servicios-de-enfermeria/toma-de-signos-vitales': 'signos-vitales',
  'servicios-de-enfermeria/acompanamiento-a-citas-medicas': 'acompanamiento-citas',
};
const servicePhoto = servicePhotos[service.slug];
const isRemoteConsultation = service.slug === 'teleconsulta-medica-colombia';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': isNationalPage ? 'MedicalWebPage' : 'MedicalProcedure',
  name: service.title,
  description: service.metaDescription,
  url: absoluteUrl(`/${service.slug}/`),
  provider: {
    '@type': 'MedicalBusiness',
    name: siteConfig.name,
    url: siteConfig.url,
    logo: absoluteUrl(siteConfig.logoPath),
    telephone: siteConfig.phone
  },
  areaServed: {
    '@type': isRemoteConsultation ? 'Country' : 'City',
    name: isRemoteConsultation ? 'Colombia' : 'Bogotá'
  }
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: service.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer
    }
  }))
};
---

<BaseLayout
  title={service.metaTitle}
  description={description}
  canonicalPath={`/${service.slug}/`}
  jsonLd={review ? { '@context': 'https://schema.org', '@type': 'WebPage', name: service.title, description, url: absoluteUrl(`/${service.slug}/`) } : [serviceSchema, faqSchema]}
>
  <section class="container py-10 md:py-16">
    <Breadcrumbs items={[
      { name: 'Inicio', path: '/' },
      ...(service.slug === 'colombia' ? [] : [{ name: service.category === 'Cobertura nacional' ? 'Colombia' : service.category, path: categoryPaths[service.category] }]),
      { name: service.shortTitle, path: `/${service.slug}/` },
    ]} />

    <div class="service-hero">
      <div class="service-intro">
        <p class="kicker">{service.category}</p>
        <h1 class="page-heading text-balance mt-3 font-extrabold tracking-tight text-slate-950">
          {service.h1}
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">{review ? description : service.summary}</p>
        <p class="coordination-note">
          {siteConfig.referralMessage}
        </p>
        <div class="service-offer">
          <div>
            <p class="text-xs font-semibold text-slate-500">Servicio solicitado</p>
            <h2 class="mt-1 text-lg font-bold text-slate-950">{service.shortTitle}</h2>
            <p class="mt-2 text-sm leading-6 text-slate-600">{review ? 'El equipo revisa el caso y la posibilidad de coordinar la atención antes de confirmar.' : service.intent}</p>
          </div>
          <div class="service-price">
            <span class="text-xs font-semibold text-slate-500">Referencia comercial</span>
            <p class="mt-1 text-xl font-extrabold text-indigo-950">{review ? 'Consultar disponibilidad' : service.price ?? 'Consultar disponibilidad'}</p>
          </div>
        </div>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <WhatsAppButton label="Consultar con SMD Vital" serviceName={service.title} /><a class="btn-secondary" href={isNursingPage ? '#precios-enfermeria' : '#detalles'}>{isNursingPage ? 'Ver precios y turnos' : 'Ver detalles'}</a>
        </div>
        <div class="mt-5 flex flex-wrap gap-2 text-xs font-bold text-slate-700">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-50 px-3 py-1.5">
            <Icon name="shield-check" class="text-indigo-700" size={16} stroke-width={1.75} aria-hidden="true" />
            Profesionales verificados en ReTHUS
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-50 px-3 py-1.5">
            <Icon name="clock" class="text-indigo-700" size={16} stroke-width={1.75} aria-hidden="true" />
            Atención hoy mismo en Bogotá
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-50 px-3 py-1.5">
            <Icon name="circle-check" class="text-indigo-700" size={16} stroke-width={1.75} aria-hidden="true" />
            Insumos estériles incluidos
          </span>
        </div>
      </div>

      <aside class="service-visual" aria-label={`Información de ${service.shortTitle}`}>
        {servicePhoto && <ServicePhoto name={servicePhoto} priority />}
        <ul class="service-highlights">
          {(review ? ['Revisión de tu solicitud', 'Zona y fecha por confirmar', 'Cotización antes de reservar'] : service.highlights).map((highlight) => (
            <li class="flex items-start gap-3">
              <Icon name="circle-check" class="mt-0.5 shrink-0 text-indigo-700" size={20} stroke-width={1.75} aria-hidden="true" />
              <span class="text-sm font-medium leading-6 text-slate-700">{highlight}</span>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  {isNursingPage && <NursingPrices />}

  {
    isNationalPage && (
      <section class="section bg-slate-50">
        <div class="container grid gap-8 lg:grid-cols-[0.8fr_1fr] lg:items-start">
          <div>
            <p class="kicker">Zona de atención</p>
            <h2 class="mt-3 text-3xl font-black tracking-tight text-slate-950 md:text-4xl">
              Atención domiciliaria en Bogotá, según disponibilidad
            </h2>
            <p class="mt-5 text-base leading-8 text-slate-600">
              Indica la localidad o barrio, el servicio y el horario que necesitas. El equipo de SMD Vital Bogotá confirma si puede atender el caso y cuál es el precio antes de reservar.
            </p>
          </div>
          <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
            <h3 class="text-lg font-black text-slate-950">Si estás fuera de Bogotá</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              No tenemos cobertura domiciliaria confirmada en otras ciudades. Puedes consultar si una teleconsulta es adecuada para tu necesidad; el equipo debe confirmar disponibilidad y alcance. Una consulta virtual no sustituye los procedimientos presenciales.
            </p>
          </div>
        </div>
      </section>
    )
  }

  <section id="detalles" class="section bg-white">
    <div class="container grid gap-10 lg:grid-cols-3">
      <div class="rounded-[28px] border border-slate-200 p-6">
        <Icon name="shield-check" class="text-indigo-700" size={24} stroke-width={1.75} aria-hidden="true" />
        <h2 class="mt-5 text-2xl font-black text-slate-950">Cuándo puede servir</h2>
        <ul class="mt-5 space-y-3 text-sm leading-6 text-slate-600">
          {service.suitableFor.map((item) => (
            <li class="flex gap-3">
              <Icon name="circle-check" class="mt-0.5 shrink-0 text-indigo-700" size={20} stroke-width={1.75} aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-[28px] border border-slate-200 p-6 lg:col-span-2">
        <Icon name="clock" class="text-indigo-700" size={24} stroke-width={1.75} aria-hidden="true" />
        <h2 class="mt-5 text-2xl font-black text-slate-950">Cómo funciona</h2>
        <ol class="mt-5 grid gap-4 md:grid-cols-2">
          {service.process.map((step, index) => (
            <li class="rounded-2xl bg-slate-50 p-5">
              <span class="text-xs font-black text-indigo-700">Paso {index + 1}</span>
              <p class="mt-2 text-sm font-semibold leading-6 text-slate-700">{step}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <div class="container mt-10 grid gap-8 lg:grid-cols-3">
      <article class="rounded-[28px] border border-slate-200 bg-slate-50/70 p-6">
        <p class="kicker">Alcance clínico</p>
        <h2 class="mt-2 text-2xl font-black text-slate-950">Qué incluye el procedimiento</h2>
        <ul class="mt-5 space-y-3 text-sm leading-6 text-slate-700">
          {service.includes.map((item) => (
            <li class="flex gap-3">
              <Icon name="circle-check" class="mt-0.5 shrink-0 text-indigo-700" size={20} stroke-width={1.75} aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </article>

      <article class="rounded-[28px] border border-slate-200 bg-white p-6">
        <p class="kicker">Guía para el hogar</p>
        <h2 class="mt-2 text-2xl font-black text-slate-950">Preparación del paciente</h2>
        <ul class="mt-5 space-y-3 text-sm leading-6 text-slate-700">
          {service.preparation.map((item) => (
            <li class="flex gap-3">
              <Icon name="clipboard-check" class="mt-0.5 shrink-0 text-indigo-700" size={20} stroke-width={1.75} aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </article>

      <article class="rounded-[28px] border border-rose-200 bg-rose-50/70 p-6">
        <p class="text-xs font-black uppercase tracking-wider text-rose-800">Seguridad del paciente · YMYL</p>
        <h2 class="mt-2 text-2xl font-black text-rose-950">Signos de alarma (Cuándo acudir a urgencias)</h2>
        <ul class="mt-5 space-y-3 text-sm leading-6 text-rose-950">
          {service.redFlags.map((item) => (
            <li class="flex gap-3">
              <Icon name="shield-plus" class="mt-0.5 shrink-0 text-rose-700" size={20} stroke-width={1.75} aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <p class="mt-4 text-xs font-bold leading-5 text-rose-900">
          Este servicio domiciliario no reemplaza una sala de urgencias. Ante urgencia vital llame a la línea 123.
        </p>
      </article>
    </div>

    {isSuturaPage && (
      <div class="container mt-10 grid gap-6 md:grid-cols-2">
        <section id="sutura-de-heridas" class="rounded-[28px] border border-slate-200 bg-white p-6">
          <p class="kicker">Procedimiento con anestesia local</p>
          <h2 class="mt-2 text-2xl font-black text-slate-950">Sutura de heridas a domicilio en Bogotá (Desde $150.000 COP)</h2>
          <p class="mt-3 text-sm leading-6 text-slate-600">
            Cierre quirúrgico de heridas cutáneas limpias y no complicadas con infiltración de anestesia local, lavado antiséptico, sutura estéril y apósito protector. Requiere valoración previa por foto clínica en WhatsApp.
          </p>
          <h3 class="mt-4 text-base font-bold text-slate-900">Requisitos para sutura en casa</h3>
          <p class="mt-1 text-sm leading-6 text-slate-600">
            Envía foto clínica de la herida, tiempo transcurrido desde la lesión y zona del cuerpo para confirmar aptitud domiciliaria y cotización exacta desde $150.000 COP.
          </p>
        </section>
        <section id="retiro-de-puntos" class="rounded-[28px] border border-slate-200 bg-white p-6">
          <p class="kicker">Control postquirúrgico</p>
          <h2 class="mt-2 text-2xl font-black text-slate-950">Retiro de puntos a domicilio en Bogotá ($120.000 COP)</h2>
          <p class="mt-3 text-sm leading-6 text-slate-600">
            Extracción segura y aséptica de puntos de sutura en heridas ya cicatrizadas por tarifa oficial de $120.000 COP. Incluye evaluación de los bordes de la herida, retiro con instrumental estéril y limpieza final.
          </p>
          <h3 class="mt-4 text-base font-bold text-slate-900">Cuándo programar el retiro</h3>
          <p class="mt-1 text-sm leading-6 text-slate-600">
            Indica cuántos días llevas con los puntos, zona anatómica e indicación de tu médico tratante para agendar tu visita hoy mismo.
          </p>
        </section>
      </div>
    )}

    {isSondaPage && (
      <div class="container mt-10 grid gap-6 md:grid-cols-2">
        <section id="cambio-colocacion-sonda" class="rounded-[28px] border border-slate-200 bg-white p-6">
          <p class="kicker">Sonda Foley o Nelaton</p>
          <h2 class="mt-2 text-2xl font-black text-slate-950">Cambio y colocación de sonda vesical en Bogotá ($170.000 COP)</h2>
          <p class="mt-3 text-sm leading-6 text-slate-600">
            Cateterismo vesical a domicilio con técnica estéril para instalación o recambio de sonda Foley (permanente con balón y bolsa recolectora) o sonda Nelaton (intermitente) por tarifa oficial de $170.000 COP.
          </p>
          <h3 class="mt-4 text-base font-bold text-slate-900">Calibre y validación urológica</h3>
          <p class="mt-1 text-sm leading-6 text-slate-600">
            Confirmamos por WhatsApp el calibre en French (Fr), tipo de sonda, lubricación anestésica e insumos estériles antes de la visita.
          </p>
        </section>
        <section id="retiro-sonda-vesical" class="rounded-[28px] border border-slate-200 bg-white p-6">
          <p class="kicker">Procedimiento seguro en casa</p>
          <h2 class="mt-2 text-2xl font-black text-slate-950">Retiro de sonda vesical a domicilio en Bogotá ($110.000 COP)</h2>
          <p class="mt-3 text-sm leading-6 text-slate-600">
            Retiro atraumático de sonda vesical a domicilio por tarifa oficial de $110.000 COP. Incluye higiene perineal, vaciado completo del balón de fijación, extracción cuidadosa y pautas de vigilancia de micción espontánea.
          </p>
          <h3 class="mt-4 text-base font-bold text-slate-900">Seguimiento post-retiro</h3>
          <p class="mt-1 text-sm leading-6 text-slate-600">
            Orientamos a la familia sobre hidratación y control de la primera micción en las horas posteriores al retiro.
          </p>
        </section>
      </div>
    )}

    {isValoracionPage && (
      <div class="container mt-10 grid gap-6 md:grid-cols-2">
        <section id="consulta-medica-domiciliaria" class="rounded-[28px] border border-slate-200 bg-white p-6">
          <p class="kicker">Atención médica en casa</p>
          <h2 class="mt-2 text-2xl font-black text-slate-950">Consulta médica domiciliaria en Bogotá ($170.000 COP)</h2>
          <p class="mt-3 text-sm leading-6 text-slate-600">
            Evaluación presencial integral por médico general en tu domicilio ($170.000 COP): historia clínica, toma de signos vitales, auscultación, examen físico completo, diagnóstico y formulación médica.
          </p>
        </section>
        <section id="valoracion-medica-prioritaria" class="rounded-[28px] border border-slate-200 bg-white p-6">
          <p class="kicker">Agendamiento mismo día</p>
          <h2 class="mt-2 text-2xl font-black text-slate-950">Valoración médica prioritaria en Bogotá ($170.000 COP)</h2>
          <p class="mt-3 text-sm leading-6 text-slate-600">
            Priorización de visita médica domiciliaria el mismo día en Bogotá ($170.000 COP) según disponibilidad en tu localidad para síntomas agudos no vitales que requieren evaluación presencial oportuna.
          </p>
        </section>
      </div>
    )}
  </section>

  {
    relatedServices.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="max-w-2xl">
            <p class="kicker">Servicios relacionados</p>
            <h2 class="mt-3 text-3xl font-black tracking-tight text-slate-950 md:text-4xl">
              Otras páginas que pueden ayudar al paciente
            </h2>
          </div>
          <div class="mt-8 grid gap-5 md:grid-cols-3">
            {relatedServices.map((related) => (
              <ServiceCard service={related} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <FAQSection faqs={service.faqs} />
  <LocalCoverageHub service={service} />
  <ConversionPanel service={service} title={`Consulta ${service.shortTitle.toLowerCase()} por WhatsApp`} />
</BaseLayout>

<style>
  .service-hero{display:grid;gap:32px;margin-top:32px;align-items:start}
  .service-offer{display:grid;gap:20px;margin-top:24px;padding:20px;border:1px solid #e2e8f0;border-radius:20px;background:#fff}
  .service-price{border-top:1px solid #e2e8f0;padding-top:16px}
  .service-visual{display:grid;gap:20px}
  .service-highlights{padding:8px 20px;border:1px solid #e2e8f0;border-radius:20px;background:#fff}
  .service-highlights li{padding-block:14px}
  .service-highlights li+li{border-top:1px solid #f1f5f9}
  @media(min-width:640px){.service-offer{grid-template-columns:minmax(0,1fr) minmax(140px,0.65fr);align-items:center}.service-price{border-top:0;border-left:1px solid #e2e8f0;padding-top:0;padding-left:20px}}
  @media(min-width:1024px){.service-hero{grid-template-columns:minmax(0,1.08fr) minmax(0,0.92fr);gap:48px}}
</style>

