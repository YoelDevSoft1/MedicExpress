---
import Icon from '../../components/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ConversionPanel from '../../components/ConversionPanel.astro';
import LocalCoverageHub from '../../components/LocalCoverageHub.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import ServicePhoto from '../../components/ServicePhoto.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { absoluteUrl, getServicesByCategory, siteConfig, type ServiceCategory } from '../../data/services';

type CategoryPage = {
  slug: string;
  category: ServiceCategory;
  title: string;
  h1: string;
  description: string;
  intro: string;
  intent: string;
};

const getCategoryPages = (): CategoryPage[] => [
  {
    slug: 'servicios-medicos',
    category: 'Servicios médicos',
    title: 'Médicos a Domicilio Bogotá desde $90.000 COP | Atención Hoy Mismo | MedicExpress',
    h1: 'Servicios médicos a domicilio con orientación clara',
    description:
      'Médicos a domicilio en Bogotá con atención hoy mismo: teleconsulta $90.000 COP, lavado de oídos $140.000 COP, consulta médica $170.000 COP y curaciones desde $150.000 COP.',
    intro:
      'Este hub reúne los servicios médicos a domicilio y virtuales en Bogotá coordinados por SMD Vital: consulta médica domiciliaria ($170.000 COP), teleconsulta ($90.000 COP), lavado de oídos ($140.000 COP), sueroterapia, curaciones y suturas (desde $150.000 COP).',
    intent: 'Médico a domicilio, teleconsulta, procedimientos menores, valoración y orientación médica.'
  },
  {
    slug: 'servicios-de-enfermeria',
    category: 'Enfermería',
    title: 'Enfermería a Domicilio Bogotá desde $95.000 COP | Atención Hoy Mismo | MedicExpress',
    h1: 'Servicios de enfermería a domicilio para pacientes y familias',
    description:
      'Enfermería a domicilio en Bogotá hoy mismo: inyectología $95.000 COP, signos vitales $100.000 COP, acompañamiento a citas $110.000 COP y turnos desde $140.000 COP (8h).',
    intro:
      'Este hub ordena los servicios de enfermería en casa coordinados con SMD Vital Bogotá: inyectología ($95.000 COP), toma de signos vitales ($100.000 COP), acompañamiento a citas médicas ($110.000 COP / 4h) y turnos de enfermería de 8h ($140.000 COP), 12h día ($160.000 COP), 12h noche ($170.000 COP) y 24h ($310.000 COP).',
    intent: 'Enfermería a domicilio, enfermera en casa, inyectología, signos vitales y cuidado de adultos mayores.'
  },
  {
    slug: 'laboratorio-clinico',
    category: 'Laboratorio clínico',
    title: 'Laboratorio Clínico a Domicilio Bogotá | Orientación por WhatsApp | MedicExpress',
    h1: 'Laboratorio clínico a domicilio y toma de muestras en casa',
    description:
      'Consulta laboratorio clínico a domicilio, toma de muestras en casa, pruebas y orientación de preparación por WhatsApp con MedicExpress y SMD Vital.',
    intro:
      'Este hub agrupa las páginas informativas de laboratorio y toma de muestras para pacientes que necesitan validar requisitos y posibilidad de atención antes de agendar.',
    intent: 'Laboratorio a domicilio, toma de muestras, exámenes en casa y preparación de pruebas.'
  }
];

export function getStaticPaths() {
  const categoryPages: CategoryPage[] = [
    {
      slug: 'servicios-medicos',
      category: 'Servicios médicos',
      title: 'Médicos a Domicilio Bogotá desde $90.000 COP | Atención Hoy Mismo | MedicExpress',
      h1: 'Servicios médicos a domicilio con orientación clara',
      description:
        'Médicos a domicilio en Bogotá con atención hoy mismo: teleconsulta $90.000 COP, lavado de oídos $140.000 COP, consulta médica $170.000 COP y curaciones desde $150.000 COP.',
      intro:
        'Este hub reúne los servicios médicos a domicilio y virtuales en Bogotá coordinados por SMD Vital: consulta médica domiciliaria ($170.000 COP), teleconsulta ($90.000 COP), lavado de oídos ($140.000 COP), sueroterapia, curaciones y suturas (desde $150.000 COP).',
      intent: 'Médico a domicilio, teleconsulta, procedimientos menores, valoración y orientación médica.'
    },
    {
      slug: 'servicios-de-enfermeria',
      category: 'Enfermería',
      title: 'Enfermería a Domicilio Bogotá desde $95.000 COP | Atención Hoy Mismo | MedicExpress',
      h1: 'Servicios de enfermería a domicilio para pacientes y familias',
      description:
        'Enfermería a domicilio en Bogotá hoy mismo: inyectología $95.000 COP, signos vitales $100.000 COP, acompañamiento a citas $110.000 COP y turnos desde $140.000 COP (8h).',
      intro:
        'Este hub ordena los servicios de enfermería en casa coordinados con SMD Vital Bogotá: inyectología ($95.000 COP), toma de signos vitales ($100.000 COP), acompañamiento a citas médicas ($110.000 COP / 4h) y turnos de enfermería de 8h ($140.000 COP), 12h día ($160.000 COP), 12h noche ($170.000 COP) y 24h ($310.000 COP).',
      intent: 'Enfermería a domicilio, enfermera en casa, inyectología, signos vitales y cuidado de adultos mayores.'
    },
    {
      slug: 'laboratorio-clinico',
      category: 'Laboratorio clínico',
      title: 'Laboratorio Clínico a Domicilio Bogotá | Orientación por WhatsApp | MedicExpress',
      h1: 'Laboratorio clínico a domicilio y toma de muestras en casa',
      description:
        'Consulta laboratorio clínico a domicilio, toma de muestras en casa, pruebas y orientación de preparación por WhatsApp con MedicExpress y SMD Vital.',
      intro:
        'Este hub agrupa las páginas informativas de laboratorio y toma de muestras para pacientes que necesitan validar requisitos y posibilidad de atención antes de agendar.',
      intent: 'Laboratorio a domicilio, toma de muestras, exámenes en casa y preparación de pruebas.'
    }
  ];
  return categoryPages.map((page) => ({
    params: { category: page.slug },
    props: { page }
  }));
}

const { page } = Astro.props as { page: CategoryPage };
const services = getServicesByCategory(page.category);
const review = page.category === 'Laboratorio clínico';
const description = review
  ? 'Consulta tu solicitud de laboratorio o toma de muestras por WhatsApp. El equipo confirma requisitos, zona, fecha y posibilidad de atención antes de reservar.'
  : page.description;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: page.title,
  description,
  url: absoluteUrl(`/${page.slug}/`),
  isPartOf: {
    '@type': 'WebSite',
    name: siteConfig.name,
    url: siteConfig.url
  },
  about: page.intent,
  provider: {
    '@type': 'MedicalBusiness',
    name: siteConfig.name,
    url: siteConfig.url,
    telephone: siteConfig.phone
  }
};
---

<BaseLayout title={page.title} description={description} canonicalPath={`/${page.slug}/`} jsonLd={schema}>
  <section class="container py-12 md:py-16">
    <div class="mb-6"><Breadcrumbs items={[{ name: 'Inicio', path: '/' }, { name: page.category, path: `/${page.slug}/` }]} /></div>
    <div class="grid gap-10 lg:grid-cols-[1fr_0.74fr] lg:items-start">
      <div>
        <p class="kicker">{page.category}</p>
        <h1 class="page-heading mt-3 text-balance font-extrabold tracking-tight text-slate-950">
          {page.h1}
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">{review ? description : page.intro}</p>
        <p class="coordination-note">
          {siteConfig.referralMessage}
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <WhatsAppButton label="Consultar por WhatsApp" serviceName={page.category} />
          <a class="btn-secondary" href="#servicios">
            <span>Ver servicios</span>
            <Icon name="arrow-right" size={20} stroke-width={1.75} aria-hidden="true" />
          </a>
        </div>
        <div class="mt-5 flex flex-wrap gap-2 text-xs font-bold text-slate-700">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-50 px-3 py-1.5">
            <Icon name="shield-check" class="text-indigo-700" size={16} stroke-width={1.75} aria-hidden="true" />
            Personal de salud calificado
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-50 px-3 py-1.5">
            <Icon name="clock" class="text-indigo-700" size={16} stroke-width={1.75} aria-hidden="true" />
            Atención hoy mismo en Bogotá
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-50 px-3 py-1.5">
            <Icon name="circle-check" class="text-indigo-700" size={16} stroke-width={1.75} aria-hidden="true" />
            Insumos estériles incluidos
          </span>
        </div>
      </div>

      <div class="surface rounded-[24px] p-5 sm:p-6">
        {page.category === 'Servicios médicos' && <div class="mb-6"><ServicePhoto name="material-visita-medica" priority /></div>}
        {page.category === 'Enfermería' && <div class="mb-6"><ServicePhoto name="auxiliar-cuidado" priority /></div>}
        <h2 class="text-2xl font-black text-slate-950">Qué puede encontrar aquí</h2>
        <ul class="mt-5 space-y-4">
          {[
            'Información sobre cada servicio',
            'Orientación responsable por WhatsApp',
            'Derivación hacia SMD Vital Bogotá cuando aplica',
            'Información clara antes de agendar'
          ].map((item) => (
            <li class="flex gap-3 text-sm font-bold leading-6 text-slate-700">
              <Icon name="circle-check" class="mt-0.5 shrink-0 text-indigo-700" size={20} stroke-width={1.75} aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="servicios" class="section bg-white">
    <div class="container">
      <div class="max-w-3xl">
        <p class="kicker">Información relacionada</p>
        <h2 class="mt-3 text-4xl font-black tracking-tight text-slate-950 md:text-5xl">
          Servicios de {page.category.toLowerCase()}
        </h2>
        <p class="mt-5 text-lg leading-8 text-slate-600">
          Revisa el alcance y el estado de disponibilidad de cada servicio antes de solicitar atención.
        </p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {services.map((service) => (
          <ServiceCard service={service} />
        ))}
      </div>
    </div>
  </section>

  <LocalCoverageHub currentCategory={page.category} />
  <ConversionPanel title={`Consulta ${page.category.toLowerCase()} por WhatsApp`} />
</BaseLayout>
